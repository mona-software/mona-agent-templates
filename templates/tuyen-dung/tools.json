{
  "template": "tuyen-dung",
  "runtime": {
    "name": "openclaw",
    "license": "MIT",
    "repo": "https://github.com/openclaw/openclaw",
    "workspace_files": [
      "AGENTS.md",
      "SOUL.md",
      "IDENTITY.md",
      "skills/*/SKILL.md"
    ]
  },
  "mcp": {
    "monacloud-mcp": {
      "install": "npx -y monacloud-mcp",
      "docs": "https://monacloud.vn/docs/mcp-va-sdk",
      "tools": [
        "cloud_whoami",
        "cloud_balance",
        "cloud_prices",
        "cloud_packages",
        "cloud_vps_create",
        "cloud_services",
        "cloud_job_status",
        "cloud_topup",
        "cloud_topup_status",
        "mail_account",
        "mail_domain_add",
        "mail_domain_verify",
        "mail_api_key_create",
        "mail_send",
        "mail_template_create",
        "mail_webhook_create",
        "mail_stats",
        "mail_inbox_create",
        "mail_inbox_messages",
        "mail_inbox_message",
        "mail_inbox_reply",
        "mail_inbox_wait"
      ]
    }
  },
  "runtime_apis": [
    "https://api.monamail.vn/v1: POST /v1/emails (gửi), POST /v1/templates, GET /v1/emails/{id}, POST /v1/webhooks, GET /v1/inboxes/{id}/messages (hộp thư agent), POST /v1/inboxes/{id}/messages/{mid}/reply"
  ],
  "env": [
    "OPENAI_COMPAT_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "MONAMAIL_API_KEY",
    "MONAMAIL_INBOX_ID"
  ],
  "products": [
    "MONA Mail",
    "MONA Cloud"
  ],
  "note": "Tên tool lấy từ code monacloud-mcp / monapay-mcp ngày 19/09/2026. Tool không có trong danh sách này thì KHÔNG tồn tại, đừng gọi. cloud_agent_deploy hiện là stub (bản thử)."
}