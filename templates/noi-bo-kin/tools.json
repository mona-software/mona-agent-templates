{
  "template": "noi-bo-kin",
  "runtime": {
    "name": "openclaw",
    "license": "MIT",
    "repo": "https://github.com/openclaw/openclaw",
    "workspace_files": [
      "AGENTS.md",
      "SOUL.md",
      "IDENTITY.md",
      "skills/*/SKILL.md"
    ]
  },
  "mcp": {
    "monacloud-mcp": {
      "install": "npx -y monacloud-mcp",
      "docs": "https://monacloud.vn/docs/mcp-va-sdk",
      "tools": [
        "cloud_whoami",
        "cloud_balance",
        "cloud_prices",
        "cloud_packages",
        "cloud_vps_create",
        "cloud_services",
        "cloud_job_status",
        "cloud_topup",
        "cloud_topup_status"
      ]
    }
  },
  "runtime_apis": [
    "Ollama local (http://127.0.0.1:11434, OpenAI-compatible)"
  ],
  "env": [
    "OLLAMA_MODEL (vd qwen2.5:7b hoặc model tiếng Việt)",
    "TELEGRAM_BOT_TOKEN (nếu dùng Telegram)"
  ],
  "products": [
    "MONA Cloud (VPS RAM lớn)",
    "Ollama"
  ],
  "note": "Tên tool lấy từ code monacloud-mcp / monapay-mcp ngày 19/09/2026. Tool không có trong danh sách này thì KHÔNG tồn tại, đừng gọi. cloud_agent_deploy hiện là stub (bản thử)."
}